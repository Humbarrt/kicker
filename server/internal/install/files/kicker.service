# The kicker server (spec 04 §6), installed by `kicker install` (the install script, the image).
[Unit]
Description=Kicker table server
After=network-online.target
Wants=network-online.target
# Always start again: a new version that dies before it is healthy is rolled back by the next
# start (spec 10 §3), so systemd must never give up.
StartLimitIntervalSec=0

[Service]
User=kicker
Group=kicker
SupplementaryGroups=dialout
# The installed version; updates switch the link (spec 10 §3).
ExecStart=/var/lib/kicker/bin/current serve --addr :80 --tls-addr :443 --data /var/lib/kicker
Restart=always
RestartSec=3
# Ports 80/443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The data folder, USB drives and network shares for backups (spec 10 §2).
ReadWritePaths=/var/lib/kicker -/media/kicker -/mnt
PrivateTmp=true

[Install]
WantedBy=multi-user.target
